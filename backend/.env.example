# Copiar como .env y completar. Nunca subir el .env al repositorio.

# Conexión a PostgreSQL (la base se crea sola con `npm run db:migrate`)
DATABASE_URL="postgresql://USUARIO:CONTRASEÑA@localhost:5432/rifas_db?schema=public"

# Puerto de la API
PORT=3100

# Secreto para firmar las sesiones (mínimo 32 caracteres; obligatorio en producción)
JWT_SECRET=""
JWT_EXPIRES_IN=12h

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:4300

# Administrador inicial (lo crea `npm run db:seed` si no existe ningún usuario)
ADMIN_NOMBRE="Hanner Obando"
ADMIN_EMAIL="admin@rifas.local"
ADMIN_PASSWORD=""
